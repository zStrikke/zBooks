includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6

    # tests/ queda fuera: PHPStan no entiende el $this de los closures de Pest
    # y daría falsos positivos. Los tests ya se comprueban al ejecutarlos.
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
